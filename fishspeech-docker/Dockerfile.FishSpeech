FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# System deps
RUN apt-get update && apt-get install -y \
    python3.11 python3.11-dev python3-pip \
    git git-lfs curl ffmpeg portaudio19-dev \
    && git lfs install \
    && rm -rf /var/lib/apt/lists/*

# Use python3.11 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

WORKDIR /app

# Clone fish-speech
RUN git clone https://github.com/fishaudio/fish-speech.git
WORKDIR /app/fish-speech

# Install torch nightly for cu128 (2.8 not on stable index)
RUN pip install --pre torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/nightly/cu128

# Install fish-speech deps (non-editable to avoid PEP 660 issue)
RUN pip install .

# Install FastAPI server deps
RUN pip install fastapi uvicorn python-multipart

# Copy API server to /app
COPY server.py /app/server.py

# Run uvicorn from /app so it finds server.py as module
WORKDIR /app
EXPOSE 8080
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]