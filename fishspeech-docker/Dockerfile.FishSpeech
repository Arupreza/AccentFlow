FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-devel AS builder

RUN --mount=type=cache,target=/var/cache/apt,sharing=private \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=private \
    apt-get update && apt-get install -y --no-install-recommends \
        git build-essential cmake \
        portaudio19-dev   # <-- fixes pyaudio: provides portaudio.h

ARG FISHSPEECH_SHA=main
RUN git clone https://github.com/fishaudio/fish-speech.git /opt/fish-speech \
    && cd /opt/fish-speech \
    && git checkout ${FISHSPEECH_SHA}

WORKDIR /opt/fish-speech

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
        "transformers>=4.40.0,<=4.57.3" \
        "tokenizers>=0.19.0" \
    && pip install -e . "huggingface_hub[cli]>=0.22"


FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN --mount=type=cache,target=/var/cache/apt,sharing=private \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=private \
    apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libsndfile1 \
        portaudio19-dev   # <-- needed at runtime too if pyaudio is used

RUN useradd -m -u 1000 appuser

RUN mkdir -p /data/input /data/output /data/checkpoints \
    && chown -R appuser:appuser /data

COPY --from=builder /opt/conda /opt/conda
COPY --from=builder /opt/fish-speech /home/appuser/fish-speech
COPY entrypoint.fish.sh /home/appuser/fish-speech/entrypoint.sh

RUN chmod +x /home/appuser/fish-speech/entrypoint.sh

USER appuser
WORKDIR /home/appuser/fish-speech

VOLUME ["/data/input", "/data/output", "/data/checkpoints"]

ENTRYPOINT ["/home/appuser/fish-speech/entrypoint.sh"]

