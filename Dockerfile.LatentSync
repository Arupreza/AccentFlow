# Use an official PyTorch base image with CUDA support to avoid manual driver setups
FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install essential system dependencies required for computer vision and audio processing
RUN apt-get update && apt-get install -y \
    git \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Establish the working directory
WORKDIR /workspace

# Clone the repository
RUN git clone https://github.com/bytedance/LatentSync.git

# Set the working directory to the cloned repository
WORKDIR /workspace/LatentSync

# Install Python dependencies specified by the authors
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install huggingface_hub

#docker build -f Dockerfile.LatentSync -t latentsync-env .