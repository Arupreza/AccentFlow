FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-devel AS builder

RUN --mount=type=cache,target=/var/cache/apt,sharing=private \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=private \
    apt-get update && apt-get install -y --no-install-recommends \
        git build-essential

ARG LATENTSYNC_SHA=main
RUN git clone https://github.com/bytedance/LatentSync.git /opt/latentsync \
    && cd /opt/latentsync \
    && git checkout ${LATENTSYNC_SHA}

WORKDIR /opt/latentsync

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt "huggingface_hub>=0.22"


FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN --mount=type=cache,target=/var/cache/apt,sharing=private \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=private \
    TMPDIR=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0

RUN useradd -m -u 1000 appuser

RUN mkdir -p /data/input /data/output /data/checkpoints \
    && chown -R appuser:appuser /data

COPY --from=builder /opt/conda /opt/conda
COPY --from=builder /opt/latentsync /home/appuser/latentsync
COPY entrypoint.latent.sh /home/appuser/latentsync/entrypoint.latent.sh

RUN chmod +x /home/appuser/latentsync/entrypoint.latent.sh

USER appuser
WORKDIR /home/appuser/latentsync

VOLUME ["/data/input", "/data/output", "/data/checkpoints"]

ENTRYPOINT ["/home/appuser/latentsync/entrypoint.latent.sh"]

#docker build -f Dockerfile.LatentSync -t latentsync-env .